DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Local dev only — used to build DATABASE_URL if it's not set. On Railway,
# the Postgres plugin sets DATABASE_URL itself and these are ignored.
DB_NAME=commodity_tracker
DB_USER=cgd
DB_PASSWORD=cgd_dev_pw
DB_HOST=127.0.0.1
DB_PORT=5432

# Set explicitly only if DATABASE_URL isn't auto-injected (Railway sets this
# for you when you attach a Postgres plugin — you don't need to set it):
# DATABASE_URL=postgres://user:password@host:port/dbname
